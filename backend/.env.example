# 백엔드 설정 예시 — 복사해서 .env 로 쓰세요
PORT=4004

# Anthropic API 키. 설정하지 않으면 AI 기능 4종(정치인 검색·정책 비교·뉴스 요약·챗봇)은
# 503 과 한국어 안내를 반환합니다. (헬스체크·검증·404 등 나머지 경로는 정상 동작)
ANTHROPIC_API_KEY=

# CORS 허용 origin (쉼표 구분). 미설정 시 localhost/127.0.0.1 의 5173,5174,4173 허용
# ALLOWED_ORIGINS=http://localhost:5174

# 요청 본문 크기 상한
JSON_LIMIT=1mb
